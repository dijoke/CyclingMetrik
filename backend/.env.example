# Copier en .env et renseigner les vraies valeurs — ne jamais committer .env (voir .gitignore)

DATABASE_URL=postgresql+psycopg://coaching:coaching@localhost:5432/coaching

# Clé Fernet pour chiffrer les tokens OAuth at-rest (Principe II — jamais en clair).
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Strava (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Garmin Connect Developer Program
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Nolio
NOLIO_CLIENT_ID=
NOLIO_CLIENT_SECRET=
